# UbaidBlogs Environment Variables

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://ubaidblogs.com

# Administrator Access
ADMIN_PASSWORD=UbaidAdmin2026!

# Supabase Database & Auth (Optional - for production cloud PostgreSQL)
# When omitted, UbaidBlogs runs smoothly using the local embedded JSON data layer
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Transactional Email Delivery (Optional)
# If provided, triggers real email delivery on newsletter subscriptions and contact form inquiries
RESEND_API_KEY=re_123456789...

# Google Search Console Verification Token
NEXT_PUBLIC_GOOGLE_VERIFICATION=google-site-verification-token

